    <bpmn:sequenceFlow id="Flow_0domj33" name="Da" sourceRef="Gateway_1kichh2" targetRef="change_status_to_payed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${nijePlaceno == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1bki7qn" name="Da" sourceRef="Gateway_1lwmq3o" targetRef="Gateway_1kichh2">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${podaciIspravni == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1s6g2ou" name="Ne" sourceRef="Gateway_1lwmq3o" targetRef="user_task_correct_data">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${podaciIspravni == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0w9abhd" name="Ne" sourceRef="Gateway_1kichh2" targetRef="send_warning_mail" />
