    <bpmn:startEvent id="StartEvent_1" name="Pregled uplata za rezervaciju" camunda:formKey="">
      <bpmn:extensionElements />
      <bpmn:outgoing>Flow_02yda1v</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="user_task_evidencija" name="Evidentiraj uplatu za rezervaciju" camunda:assignee="iznajmljivac">
      <bpmn:incoming>Flow_02yda1v</bpmn:incoming>
      <bpmn:incoming>Flow_1elan7b</bpmn:incoming>
      <bpmn:incoming>Flow_0wdpx8w</bpmn:incoming>
      <bpmn:outgoing>Flow_1e7f93r</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="change_status_to_payed" name="Promijeni status uplate u &#34;Plaćeno&#34;">
      <bpmn:incoming>Flow_0domj33</bpmn:incoming>
      <bpmn:outgoing>Flow_1rhqiuu</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_1kichh2" name="Je li rezervacija potpuno otplaćena?">
      <bpmn:incoming>Flow_1bki7qn</bpmn:incoming>
      <bpmn:outgoing>Flow_0domj33</bpmn:outgoing>
      <bpmn:outgoing>Flow_0w9abhd</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_1lwmq3o" name="Jesu li svi uneseni podatci ispravni?">
