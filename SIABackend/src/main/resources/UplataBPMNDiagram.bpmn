      <bpmn:incoming>Flow_1e7f93r</bpmn:incoming>
      <bpmn:outgoing>Flow_1bki7qn</bpmn:outgoing>
      <bpmn:outgoing>Flow_1s6g2ou</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="user_task_correct_data" name="Ispravi unesene podatke">
      <bpmn:incoming>Flow_1s6g2ou</bpmn:incoming>
      <bpmn:outgoing>Flow_1elan7b</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_02yda1v" sourceRef="StartEvent_1" targetRef="user_task_evidencija" />
    <bpmn:sequenceFlow id="Flow_1elan7b" sourceRef="user_task_correct_data" targetRef="user_task_evidencija" />
    <bpmn:sequenceFlow id="Flow_1e7f93r" sourceRef="user_task_evidencija" targetRef="Gateway_1lwmq3o" />
