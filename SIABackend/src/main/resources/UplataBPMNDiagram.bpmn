      <bpmn:outgoing>Flow_187bvj9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:eventBasedGateway id="Gateway_1s0yjtx" name="Čekanje na uplatu">
      <bpmn:incoming>Flow_187bvj9</bpmn:incoming>
      <bpmn:outgoing>Flow_0aeyruz</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:exclusiveGateway id="Gateway_0fla6sw" name="Je li uplata stigla?">
