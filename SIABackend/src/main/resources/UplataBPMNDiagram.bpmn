    <bpmn:endEvent id="Event_16wd3y8" name="Kraj pregleda uplata">
      <bpmn:incoming>Flow_0h2w0xj</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_1" name="Kraj pregleda uplata">
      <bpmn:incoming>Flow_1rhqiuu</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_18twyin" sourceRef="Gateway_0fla6sw" targetRef="user_task_evidencija">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${uplataOtplacena == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_0wdpx8w" sourceRef="Gateway_0fla6sw" targetRef="delete_payment_and_reservation">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${uplataOtplacena == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:intermediateCatchEvent id="Event_1qpzspk" name="2 tjedna">
